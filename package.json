  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check.mjs",
    "check": "node scripts/check.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "playwright test",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "media": "node scripts/process-media.mjs",
    "deploy:branch": "node scripts/deploy-branch.mjs",
    "brand:frames": "node scripts/brand-frames.mjs",
    "films": "node scripts/generate-films.mjs",
    "films:shots": "python -I films/build-shots.py",
    "films:prompts": "python -I films/build-shots.py && python -I films/export-prompts.py"
  },
