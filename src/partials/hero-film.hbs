{{!-- Only stops with a produced clip are included (vite-plugins/media.js). --}}
{{#if film.stops.length}}
<div class="hero-film" aria-hidden="true">
  {{#each film.stops}}
  <div class="hero-film__scene hero-film__scene--{{id}}" data-stop="{{id}}" data-circle="{{circle}}" data-tag="{{tag}}" {{{mediaAttrs (concat "/media/film/" id)}}}></div>
  {{/each}}
  <div class="hero-film__you" data-stop="voce"><p>Venha fazer parte da <em class="hl">roda</em>.</p></div>
</div>
<div class="hero-film__overlays" aria-hidden="true">
  <span class="hero-film__tag"></span>
  <div class="overlay overlay--chat" data-for="barbearia">
    <div class="chat__head"><img class="chat__avatar" src="/src/assets/brand/simbolo-negativa.svg" alt="" width="30" height="30"><span class="chat__name">Barbearia do Samuel<small>Agente Southia · online</small></span></div>
    <div class="chat__body">
      {{#each film.chat}}
      <p class="chat__msg chat__msg--{{from}}">{{text}}</p>
      {{/each}}
      <p class="chat__typing"><span></span><span></span><span></span></p>
    </div>
  </div>
  <div class="overlay overlay--instagram" data-for="clinica">
    <div class="ig__head"><span class="ig__avatar"></span><span class="ig__name">Clínica Movimento<small>Agente Southia · Instagram</small></span></div>
    <div class="ig__grid">
      <span class="ig__tile" data-pop></span><span class="ig__tile ig__tile--b" data-pop></span><span class="ig__tile ig__tile--c" data-pop></span>
      <span class="ig__tile ig__tile--b" data-pop></span><span class="ig__tile ig__tile--c" data-pop></span><span class="ig__tile" data-pop></span>
    </div>
    <p class="ig__toast" data-pop>✓ Post de hoje publicado automaticamente</p>
    <p class="ig__chips" data-pop><span>Seg 9h</span><span>Qua 18h</span><span>Sex 12h</span></p>
  </div>
  <div class="overlay overlay--dados" data-for="advocacia">
    <p class="feed__title">Helena Duarte Advocacia</p>
    <p class="feed__sources"><span data-pop>TJSP</span><span data-pop>PJe</span><span data-pop>e-SAJ</span><span data-pop>Diário Oficial</span></p>
    <ul class="feed__list">
      <li data-pop><span class="feed__check">✓</span>Pesquisa realizada no TJSP: 14 novas decisões</li>
      <li data-pop><span class="feed__check">✓</span>Dados baixados automaticamente do PJe e do e-SAJ</li>
      <li data-pop><span class="feed__check">✓</span>Diário Oficial: 3 publicações dos seus processos</li>
    </ul>
    <p class="feed__status" data-pop><span class="feed__dot"></span>Relatório pronto na sua pasta</p>
  </div>
  <p class="overlay overlay--headline" data-for="roda">Pessoas, dados e IA na mesma <em class="hl">roda</em>.</p>
</div>
{{/if}}
