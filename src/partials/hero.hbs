<section id="topo" class="hero section--dark" data-screen-label="Hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow eyebrow--sage">Tecnologia com gente dentro</p>
      <h1 class="hero__title" data-split="hero">Pessoas, dados e IA na mesma <em class="hl">roda</em>.</h1>
      <p class="hero__lead">A Southia une atendimento, automação, dados e inteligência artificial para que o seu negócio atenda melhor, venda mais e decida com clareza — sem perder o lado humano.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="#contato" data-magnetic>Agendar uma conversa</a>
        <a class="btn btn--ghost" href="#solucoes">Ver soluções</a>
      </div>
    </div>
    <div class="hero__ring">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__rotor" aria-hidden="true">
        <svg class="hero__spokes" viewBox="0 0 100 100" preserveAspectRatio="none">
          {{#each hero.avatars}}<line x1="50" y1="50" x2="{{x}}" y2="{{y}}" pathLength="1"/>{{/each}}
        </svg>
        <svg class="hero__ring-svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="42" pathLength="1"/></svg>
        <div class="hero__circle hero__circle--inner"></div>
        <div class="hero__orbit" data-orbit><span class="hero__orbit-dot"></span></div>
        <div class="hero__orbit hero__orbit--rev" data-orbit-rev><span class="hero__orbit-dot hero__orbit-dot--sm"></span></div>
        <div class="hero__spark-glow"></div>
        <div class="hero__spark" data-spark></div>
        {{#each hero.avatars}}
        <div class="hero__avatar hero__avatar--{{@index}}"><div class="hero__pop"><div class="hero__face" data-bob>{{> media-slot id=id alt=alt shape="circle"}}</div></div></div>
        {{/each}}
        <a class="hero__you" href="#contato" tabindex="-1"><span class="hero__pop"><span class="hero__you-inner" data-pulse>+ você</span></span></a>
      </div>
      {{> hero-film}}
      <button class="motion-toggle" type="button" aria-pressed="false" aria-label="Pausar animações">
        <svg class="motion-toggle__icon motion-toggle__icon--pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
        <svg class="motion-toggle__icon motion-toggle__icon--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
      </button>
    </div>
  </div>
  {{> divider from="none" to="cream"}}
</section>
